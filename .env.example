# Aquilla SPA environment variables
#
# Copy to .env.local and fill in your values:
#   cp .env.example .env.local
#
# `pnpm dev` writes .env.development.local automatically from scripts/dev-stack.ts,
# overriding these values for local development. You only need to set them here
# for custom setups or when running `pnpm dev:vite` (bare Vite, no dev-stack).
#
# NEVER commit real secrets. This file contains placeholder values only.

# Identity / auth worker URL.
# Production: https://api.aquilla.app/identity
# Staging:    https://api.dev.aquilla.app/identity
# Local:      http://127.0.0.1:8788  (set by pnpm dev via dev-stack.ts)
VITE_AUTH_BASE=http://127.0.0.1:8788

# Chat-completion proxy URL (auth-worker owns /chat since 2026-05-26).
# Production: https://api.aquilla.app/chat
# Staging:    https://api.dev.aquilla.app/chat
# Local:      http://127.0.0.1:8788  (same worker as auth)
VITE_CHAT_BASE=http://127.0.0.1:8788

# Sync worker host (no trailing slash; path segment /sync may be appended by code).
# Production: api.aquilla.app/sync
# Staging:    api.dev.aquilla.app/sync
# Local:      127.0.0.1:8789  (set by pnpm dev via dev-stack.ts)
VITE_SYNC_WORKER_HOST=127.0.0.1:8789

# Legacy fallback for sync-token minting and chat; kept for E2E suite compat.
# Prefer VITE_AUTH_BASE and VITE_CHAT_BASE for new setups.
# VITE_FRONTIER_BASE=http://127.0.0.1:8788

# PostHog analytics (optional — omit to disable telemetry entirely).
# VITE_POSTHOG_KEY=phc_yourprojectkey
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# MMS speech recognition model hosting (optional).
# Defaults to the Hugging Face hub when unset. Override to use self-hosted models.
# VITE_MMS_RUNTIME=sherpa-onnx                   # or: transformers
# VITE_MMS_MODEL_REMOTE_HOST=                    # e.g. https://your-r2-bucket.example.com
# VITE_MMS_MODEL_REMOTE_PATH_TEMPLATE=           # path template with {lang} placeholder
# VITE_MMS_MODEL_REPO_PREFIX=                    # HF repo prefix (transformers runtime)
# VITE_MMS_SHERPA_ONNX_REPO=                     # Sherpa-ONNX HF repo name
# VITE_MMS_SHERPA_ONNX_REMOTE_HOST=              # Sherpa-ONNX model host override

# Beta flag — shows a "beta" badge next to the logo with an expectations modal.
# Set to "0" (or omit) at build time to hide it. Defaults to "1" in vite.config.ts.
# VITE_BETA_FLAG=1

# Brand (injected at build time — not a runtime env var; BRAND= is the actual knob).
# See README.md "Multi-brand build system". Valid values: aquilla | codex | honeycomb | context
# VITE_BRAND=aquilla

# VITE_GOOGLE_CLIENT_ID=
# VITE_GOOGLE_API_KEY=