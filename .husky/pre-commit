#!/usr/bin/env sh
# Warn-only scope guard: a branch should carry commits for ONE ticket.
#
# When QA reviews a PR-to-main they map it by the AQU-### its commits carry
# (AGENTS.md → "Issue workflow"). A branch named for AQU-A that also holds
# AQU-B commits makes that mapping a lie and is the usual symptom of agents
# piling unrelated work onto whatever branch happens to be checked out.
#
# This never blocks (prototyping fast-path stays smooth) — it just surfaces the
# drift so you can move the unrelated work to its own branch/worktree.

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
bt=$(printf '%s' "$branch" | grep -oiE 'aqu-[0-9]+' | head -1 | tr '[:lower:]' '[:upper:]')

# No ticket in the branch name → nothing to compare against.
[ -z "$bt" ] && exit 0

# Tickets referenced by commits already on this branch, counted from the
# nearer of origin/dev (where PRs land) and origin/main (hotfixes). Against
# main alone, every branch cut from dev listed all of dev's unreleased tickets.
base=origin/main
best=$(git rev-list --count origin/main..HEAD 2>/dev/null || echo 999999)
dev_count=$(git rev-list --count origin/dev..HEAD 2>/dev/null || echo 999999)
if [ "$dev_count" -lt "$best" ]; then base=origin/dev; fi

# `|| true`: husky runs hooks with `sh -e`, and grep exits 1 when it selects
# nothing — i.e. on every clean single-ticket branch — which turned this
# warn-only guard into a hard commit blocker. Guarantee the promise above.
others=$(git log --pretty=%s "$base"..HEAD 2>/dev/null \
  | grep -oiE 'AQU-[0-9]+' | tr '[:lower:]' '[:upper:]' | sort -u | grep -v "^${bt}$" || true)

if [ -n "$others" ]; then
  echo "[pre-commit] ⚠ branch '$branch' (ticket $bt) already has commits for OTHER tickets:"
  printf '   - %s\n' $others
  echo "   One ticket per branch keeps QA's PR→ticket mapping honest."
  echo "   Move the unrelated work to its own branch/worktree (see AGENTS.md → Issue workflow)."
fi
exit 0
