#!/usr/bin/env sh

# Preserve Git's ref update stream before pnpm/vitest inherit stdin.
E2E_PUSH_REFS=$(cat)
export E2E_PUSH_REFS

# Run validation locally so Cloudflare can publish previews immediately after
# compilation. check:push scans credentials before lint or test suites.
echo "[pre-push] running validation (pnpm run check:push)…"
pnpm run check:push
status=$?
if [ $status -ne 0 ]; then
  echo "[pre-push] Validation failed. Push blocked."
  exit $status
fi

echo "[pre-push] running changed-file E2E gate (pnpm run test:e2e:affected)…"
pnpm run test:e2e:affected
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "❌ Affected E2E gate failed. Push blocked."
  echo "   Debug: npm run test:e2e:ui"
  echo "   Bypass (NOT recommended): git push --no-verify"
  exit $status
fi

echo "[pre-push] ✅ affected E2E passed"
exit 0
