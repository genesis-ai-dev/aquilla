#!/usr/bin/env sh

# Pre-push gate: run the E2E smoke against the in-repo codex-auth-worker +
# sync-worker. No external checkout required — schemas are vendored under
# `e2e/sql/` so wrangler can stand the stack up locally.
#
# Bypass with SKIP_E2E_SMOKE=1 if you're pushing a docs-only change or a
# branch where you've already run the suite locally. CI is the canonical
# gate; this hook is a developer convenience.

if [ "${SKIP_E2E_SMOKE:-}" = "1" ]; then
  echo "[pre-push] SKIP_E2E_SMOKE=1 — skipping E2E smoke"
  exit 0
fi

echo "[pre-push] running E2E smoke (npm run test:e2e:smoke)…"
npm run test:e2e:smoke
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "❌ E2E smoke failed. Push blocked."
  echo "   Debug: npm run test:e2e:ui"
  echo "   Skip:  SKIP_E2E_SMOKE=1 git push"
  echo "   Force: git push --no-verify  (NOT recommended)"
  exit $status
fi

echo "[pre-push] ✅ smoke passed"
exit 0
