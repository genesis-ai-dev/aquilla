#!/usr/bin/env sh

# Preserve Git's ref update stream before pnpm/vitest inherit stdin.
E2E_PUSH_REFS=$(cat)
export E2E_PUSH_REFS

# Tests create temporary Git repositories. Do not let this hook's repository
# variables redirect their Git commands into the repository being pushed.
for git_env_name in $(git rev-parse --local-env-vars); do
  unset "$git_env_name"
done

# Keep pushes proportional: scan credentials, then select browser tests from
# the pushed commits. Full unit/worker and smoke suites are not push gates.
echo "[pre-push] scanning tracked files for credentials…"
pnpm run scan:secrets
status=$?
if [ $status -ne 0 ]; then
  echo "[pre-push] Secret scan failed. Push blocked."
  exit $status
fi

echo "[pre-push] running changed-file E2E gate (pnpm run test:e2e:affected)…"
pnpm run test:e2e:affected
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "❌ Affected E2E gate failed. Push blocked."
  echo "   Debug: npm run test:e2e:ui"
  echo "   Bypass (NOT recommended): git push --no-verify"
  exit $status
fi

echo "[pre-push] ✅ affected E2E passed"
exit 0
