#!/usr/bin/env sh
# Auto-link the Linear ticket (FRO-###) into the commit message.
#
# Why: QA reviews a PR-to-main by scanning which FRO tickets its commits carry
# (see AGENTS.md → "Issue workflow"). Every commit should map to a ticket so the
# board and the merge stay reconcilable. This hook derives the ticket from the
# branch name (the `ryder/fro-###-…` convention Linear suggests) and injects it
# when missing. It is **non-blocking**: if it can't derive a ticket it just warns.

msg_file="$1"
src="$2"

# Don't rewrite merge/squash messages — they aggregate many commits.
case "$src" in
  merge|squash) exit 0 ;;
esac

# Already references a ticket anywhere in the message — leave it alone.
if grep -qiE 'FRO-[0-9]+' "$msg_file"; then
  exit 0
fi

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
ticket=$(printf '%s' "$branch" | grep -oiE 'fro-[0-9]+' | head -1 | tr '[:lower:]' '[:upper:]')

if [ -z "$ticket" ]; then
  echo "[prepare-commit-msg] ⚠ no FRO-### in message and none derivable from branch '$branch'."
  echo "                     Add the ticket (e.g. 'fix(x): … (FRO-123)') so QA can map this commit to a ticket."
  exit 0
fi

first_line=$(sed -n '1p' "$msg_file")
first_char=$(printf '%s' "$first_line" | cut -c1)

if [ -n "$first_line" ] && [ "$first_char" != "#" ]; then
  # Subject already typed (e.g. `git commit -m`) — append "(FRO-###)" to it,
  # matching the repo's existing convention.
  awk -v t="$ticket" 'NR==1 { print $0 " (" t ")"; next } { print }' "$msg_file" > "$msg_file.tmp" \
    && mv "$msg_file.tmp" "$msg_file"
else
  # Editor/template case — subject not written yet. Drop a trailer at the end so
  # the reference survives without hijacking the subject line.
  printf '\nRefs: %s\n' "$ticket" >> "$msg_file"
fi

echo "[prepare-commit-msg] linked $ticket from branch '$branch'"
exit 0
