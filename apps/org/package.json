{
  "name": "@aquilla/org",
  "private": true,
  "version": "0.1.0",
  "description": "Aquilla org admin app — orgs, members matrix, multi-project invites. Spec §21 / AD-11.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:preview": "wrangler deploy --env preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aquilla/api-client": "file:../../packages/api-client",
    "@aquilla/auth-client": "file:../../packages/auth-client",
    "@aquilla/errors": "file:../../packages/errors",
    "@aquilla/ui": "file:../../packages/ui"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240117.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "happy-dom": "^20.8.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitest": "^4.1.4",
    "wrangler": "^4.83.0"
  }
}
