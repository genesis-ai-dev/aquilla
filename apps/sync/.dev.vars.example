# Copy to .dev.vars for local dev (.dev.vars is gitignored).
# For production secrets use: wrangler secret put SYNC_SECRET_KEY

# Must match identity's SYNC_SECRET_KEY so /sync-token JWTs verify here.
# Distinct from Frontier's main SECRET_KEY (which signs access tokens) so a
# sync-worker compromise cannot forge Frontier access tokens.
SYNC_SECRET_KEY="test-sync-secret-key"

# Dev bypass. Lets clients connect without a valid sync-token JWT. Safe for
# local dev while the client isn't yet fetching /sync-token. DO NOT set this
# in production — prod default (unset) enforces strict auth.
ALLOW_UNAUTHENTICATED="true"
