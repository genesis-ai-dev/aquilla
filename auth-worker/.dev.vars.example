# Copy to .dev.vars for local dev (.dev.vars is gitignored).
# For production secrets use: wrangler secret put <NAME>

# Frontier JWT signing key. MUST match prod frontier-server's value so JWTs
# minted here verify against the old frontier-server (and vice versa) — this
# worker is a side-by-side writer on the same frontier-db-v2.
SECRET_KEY="dev-frontier-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="43200"

# Signs short-lived sync-token JWTs handed to codex-sync-worker. MUST match
# the codex-sync-worker SYNC_SECRET_KEY value (distinct from SECRET_KEY so a
# sync-worker compromise cannot forge access tokens).
SYNC_SECRET_KEY="test-sync-secret-key"

# FRO-346: base URL auth-worker calls to notify sync-worker of admin events
# (member removal -> live WS eject, project archive, file delete). Without
# this (or if it's wrong), those notifications silently no-op — see
# notifySyncWorkerOfMemberRemoval's early-return on a missing SYNC_WORKER_URL.
# `pnpm dev` (scripts/dev-stack.ts) overrides this automatically to match its
# own sync-worker port; only needed here if you run
# `wrangler dev` in auth-worker/ directly. Default sync-worker port is 8789
# (see scripts/dev-stack.ts SYNC_PORT) — do NOT use 8788, that's this
# worker's own port.
SYNC_WORKER_URL="http://127.0.0.1:8789"

# GitLab admin token used for user provisioning + PAT minting during register/login.
# Without these, /register returns 503; /token still works for existing users
# but the GitLab token refresh is skipped.
GITLAB_URL="https://gitlab.frontierrnd.com"
GITLAB_ADMIN_TOKEN=""

# Email goes through the Cloudflare Email Service `send_email` binding, which
# is only declared in deployed env blocks (wrangler.toml) — locally there is
# no binding, so invite emails no-op and password reset returns an error.
EMAIL_FROM="noreply@support.aquilla.app"
BASE_URL="http://127.0.0.1:5173"

# Optional. Marks the runtime so routes can dial back error verbosity.
ENVIRONMENT="development"

# OpenRouter key for the /api/v1/chat/completions proxy (folded in from
# the former aquilla-chat-worker on 2026-05-26). Without this, chat
# requests return 500. Grab a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=""
DEFAULT_LLM_MODEL="anthropic/claude-sonnet-4.5"

# DO NOT put WRANGLER_LOCAL in this file (or in any deployed env). It's
# injected by `scripts/dev-stack.ts` only and unlocks /__test__/reset and
# /__dev__/{seed,login} — see routes/dev-seed.ts and routes/test-reset.ts.
# If you launch auth-worker manually via `wrangler dev`, prepend
# `WRANGLER_LOCAL=1` on the command line; never persist it.
