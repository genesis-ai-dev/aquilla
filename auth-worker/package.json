    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261029.1",
    "@electric-sql/pglite": "^0.5.13",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
