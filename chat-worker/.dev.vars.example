# Copy to .dev.vars for local dev (.dev.vars is gitignored).
# For production secrets use: wrangler secret put <NAME>

# Frontier JWT signing key. MUST match codex-auth-worker (and the legacy
# frontier-server) so the same Bearer token verifies against every worker
# in the stack.
SECRET_KEY="dev-frontier-secret"
ALGORITHM="HS256"

# OpenRouter API key (https://openrouter.ai/keys). Forwarded as the
# Authorization: Bearer header on outbound completion requests.
OPENROUTER_API_KEY=""

# Used when the client requests model "default" / "free-tier" / "".
DEFAULT_LLM_MODEL="anthropic/claude-sonnet-4.5"

# Optional. Marks the runtime so routes can dial back error verbosity.
ENVIRONMENT="development"
