[Unit]
Description=Aquilla migrate daemon (GitLab to Aquilla content and audio)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aquilla-migrate
Group=aquilla-migrate
WorkingDirectory=/opt/aquilla-migrate/app
EnvironmentFile=/etc/aquilla-migrate/env
Environment=PATH=/opt/node22/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_OPTIONS=--max-old-space-size=2048
Environment=MIGRATE_HOME=/var/lib/aquilla-migrate
ExecStart=/opt/node22/bin/node /opt/aquilla-migrate/app/node_modules/tsx/dist/cli.mjs scripts/migrate-daemon/main.ts daemon
Restart=always
RestartSec=10
MemoryHigh=2600M
MemoryMax=3G
TasksMax=128
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=600
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/aquilla-migrate
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
