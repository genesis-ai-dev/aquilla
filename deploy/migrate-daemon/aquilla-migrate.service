[Unit]
Description=Aquilla migrate daemon (GitLab -> Aquilla content sync)
After=network-online.target
Wants=network-online.target

[Service]
User=clear
WorkingDirectory=/home/clear/aquilla
EnvironmentFile=/etc/aquilla-migrate/env
Environment=NODE_OPTIONS=--max-old-space-size=16384
Environment=MIGRATE_HOME=/home/clear/aquilla-migrate
Environment=PATH=/home/clear/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/clear/.local/bin/pnpm migrate:daemon daemon
Restart=always
RestartSec=10
MemoryMax=32G
# ExecStart runs through pnpm + tsx, so the cgroup holds pnpm/tsx/node.
# KillMode=control-group (the default) would send SIGTERM to every process in
# the cgroup, and pnpm/tsx forward their own copy to node within ms of the
# daemon's own signal — main.ts's withLock tolerates that duplicate, but only
# the main process should receive SIGTERM at all: KillMode=mixed sends
# SIGTERM to the main PID only, then SIGKILL to the rest of the group once it
# exits. TimeoutStopSec gives an in-flight drain (release the R2 run lock
# after the current chunk) up to 10 minutes before systemd escalates to
# SIGKILL.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=600
StandardOutput=append:/home/clear/aquilla-migrate/daemon.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
