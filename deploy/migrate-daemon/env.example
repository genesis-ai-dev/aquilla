# /etc/aquilla-migrate/env — EnvironmentFile for the aquilla-migrate systemd unit.
# Copy to /etc/aquilla-migrate/env (mode 640, root:aquilla-migrate) and fill in real values.
# See docs/MIGRATE-DAEMON.md for the full contract; every key here is read by
# scripts/migrate-daemon/config.ts's loadConfig() (or main.ts for DRY_RUN).

# Local state root: daemon.db, clones/, plans/, daemon.log. Also set directly as
# Environment= in the unit file, but harmless to repeat here.
MIGRATE_HOME=/var/lib/aquilla-migrate

# Base URL of the sync-worker's HTTP API the daemon pushes events to.
SYNC_BASE=https://api.aquilla.app/sync

# Shared secret the daemon authenticates to sync-worker with (same secret
# sync-worker validates internal/service callers against). REQUIRED.
SYNC_SECRET_KEY=REPLACE_ME

# Base URL of the GitLab instance being migrated off of. REQUIRED.
GITLAB_URL=https://gitlab.example.com

# GitLab personal/service access token with read access to every project the
# daemon must clone and inspect. REQUIRED.
FRONTIER_TOKEN=REPLACE_ME

# Identifies this daemon instance in sync-worker migrate-runner headers and
# lock-holder strings. Use the box's hostname-qualified name.
MIGRATE_RUNNER=daemon@ubuntu-4gb-hel1-1

# Steady-state target is 400 (see docs/MIGRATE-DAEMON.md#pacing-knobs); start
# canary/rollout runs at 100 and raise once Hyperdrive + PostHog look clean.
PUSH_EVENTS_PER_SEC=100

# Concurrent git fetch operations (stage 2). Keep low on a small server.
FETCH_CONCURRENCY=1

# Concurrent materialize (NDJSON plan build) operations (stage 3).
MATERIALIZE_CONCURRENCY=1

# Concurrent R2 audio object copies. Audio only transfers changed attachments;
# it does not download attachment bodies to this server.
AUDIO_COPY_CONCURRENCY=4

# Poll webhook inbox every 5 seconds. The daemon polls independently while
# clone/materialize/push work is running.
MIGRATE_INBOX_POLL_MS=5000

# Periodic GitLab reconciliation catches webhook events the inbox missed.
MIGRATE_RECONCILE_MS=900000

# Optional: Discord webhook URL for the hourly digest and failure pings.
# Leave unset to disable Discord notifications entirely.
DISCORD_WEBHOOK_URL=

# Optional: R2 credentials for the run lock (required once DRY_RUN=0, since
# the lock only lives in R2 and is skipped while dry-run). Same bucket
# (aquilla-snapshots) that scripts/migrate-all.ts --apply locks against.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 1 = log what would be pushed without writing to prod (no run lock taken,
# jobs park at `planned`). 0 = push for real. Start every deploy at 1.
DRY_RUN=1
