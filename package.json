{
  "name": "codex-web-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev-stack.ts",
    "dev:vite": "vite",
    "predev:vite": "node scripts/ensure-port-free.mjs 5173",
    "predev:codex": "node scripts/ensure-port-free.mjs 5173",
    "dev:codex": "BRAND=codex vite",
    "predev:honeycomb": "node scripts/ensure-port-free.mjs 5173",
    "dev:honeycomb": "BRAND=honeycomb vite",
    "predev:context": "node scripts/ensure-port-free.mjs 5173",
    "dev:context": "BRAND=context vite",
    "build": "tsc -b && vite build && tsx scripts/check-brand-build.ts aquilla",
    "build:codex": "BRAND=codex tsc -b && BRAND=codex vite build && tsx scripts/check-brand-build.ts codex",
    "build:honeycomb": "BRAND=honeycomb tsc -b && BRAND=honeycomb vite build && tsx scripts/check-brand-build.ts honeycomb",
    "build:context": "BRAND=context tsc -b && BRAND=context vite build && tsx scripts/check-brand-build.ts context",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:smoke": "tsx scripts/e2e-up.ts -- smoke.spec",
    "test:e2e": "tsx scripts/e2e-up.ts",
    "test:e2e:ui": "tsx scripts/e2e-up.ts -- --ui",
    "test:e2e:debug": "tsx scripts/e2e-up.ts -- --debug",
    "//test:e2e:tauri": "Plan 3 — config file does not yet exist; this script will fail until Tauri smoke is implemented.",
    "test:e2e:tauri": "playwright test --config e2e/config/playwright.config.tauri.ts",
    "mms:r2:publish": "node scripts/mms-r2-publish.mjs",
    "tauri": "tauri",
    "pretauri:dev": "node scripts/ensure-port-free.mjs 1420",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:mac": "bash -c 'set -a; [ -f .env.signing ] && . ./.env.signing; set +a; tauri build'",
    "deploy:aquilla:spa": "npm run build && rm -f dist/_redirects && wrangler deploy --env=production",
    "deploy:aquilla:sync": "cd sync-worker && wrangler deploy --env=production",
    "deploy:aquilla:auth": "cd auth-worker && wrangler deploy --env=production",
    "deploy:aquilla:api": "npm run deploy:aquilla:sync && npm run deploy:aquilla:auth",
    "deploy:aquilla": "npm run deploy:aquilla:spa && npm run deploy:aquilla:api",
    "deploy:codex": "npm run build:codex && wrangler pages deploy dist --project-name=codex-web --commit-dirty=true",
    "deploy:honeycomb": "npm run build:honeycomb && wrangler pages deploy dist --project-name=honeycomb-studio --commit-dirty=true",
    "deploy:context": "npm run build:context && wrangler pages deploy dist --project-name=context-studio --commit-dirty=true",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@huggingface/transformers": "^4.2.0",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-virtual": "^3.13.23",
    "@tauri-apps/api": "^2.10.1",
    "@tiptap/core": "^3.22.3",
    "@tiptap/extension-bubble-menu": "^3.22.3",
    "@tiptap/extension-underline": "^3.22.3",
    "@tiptap/pm": "^3.22.3",
    "@tiptap/react": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.3",
    "idb": "^8.0.3",
    "isomorphic-git": "^1.37.5",
    "jszip": "^3.10.1",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^1.8.0",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "posthog-js": "^1.372.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-player": "^3.4.0",
    "react-router-dom": "^7.14.0",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.9",
    "husky": "^9.1.7",
    "pg": "^8.21.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-node-polyfills": "^0.26.0",
    "vitest": "^4.1.4",
    "wrangler": "^4.83.0"
  }
}
