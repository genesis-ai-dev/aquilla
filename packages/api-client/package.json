{
  "name": "@aquilla/api-client",
  "private": true,
  "version": "0.1.0",
  "description": "Typed fetch wrappers for the Aquilla auth/sync APIs. Copied from src/lib/sync/*-read.ts (Phase 2b read pattern: no React Query, no SWR; thin async fns + named errors).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./projects": "./src/projects.ts",
    "./members": "./src/members.ts",
    "./orgs": "./src/orgs.ts",
    "./invites": "./src/invites.ts",
    "./settings": "./src/settings.ts",
    "./config": "./src/config.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^4.1.4"
  }
}
