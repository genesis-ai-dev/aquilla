{
  "name": "@aquilla/idml-roundtrip",
  "version": "2.0.3",
  "description": "Strict, runtime-neutral IDML parsing and protected-slot round-trip export",
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run fixtures:check && pnpm run test:unit && pnpm run test:conformance:browser",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:conformance:node": "vitest run --config vitest.config.ts src/conformance/corpus.node.test.ts",
    "test:conformance:browser": "tsx scripts/run-browser-conformance.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "fixtures:generate": "tsx scripts/generate-corpus.ts",
    "fixtures:check": "tsx scripts/generate-corpus.ts --check",
    "prepack": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sparticuz/chromium": "149.0.0",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genesis-ai-dev/aquilla.git",
    "directory": "packages/idml-roundtrip"
  }
}
