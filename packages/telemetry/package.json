    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "posthog-js": "*"
  },
  "peerDependenciesMeta": {
    "posthog-js": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.1.4"
  }
}
