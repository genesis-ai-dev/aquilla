{
  "name": "@aquilla/telemetry",
  "private": true,
  "version": "0.0.0",
  "description": "Aquilla telemetry SDK — error reporting, perf, usage events. Pluggable: real client (PostHog) or noop for opt-out / SSR / tests.",
