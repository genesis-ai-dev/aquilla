{
  "name": "@aquilla/ui",
  "private": true,
  "version": "0.0.1",
  "description": "Aquilla shared design-system primitives (shadcn/ui style, Tailwind v4). Lean copies suitable for the standalone login/signup/reset apps. The workspace SPA still uses src/components/ui/ until Phase 3a dedupes.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./button": "./src/button.tsx",
    "./button-variants": "./src/button-variants.ts",
    "./input": "./src/input.tsx",
    "./label": "./src/label.tsx",
    "./card": "./src/card.tsx",
    "./alert": "./src/alert.tsx",
    "./form-row": "./src/form-row.tsx",
    "./cn": "./src/cn.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.8.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "~6.0.2",
    "vitest": "^4.1.4"
  }
}
