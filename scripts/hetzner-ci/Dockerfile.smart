# Reviewed harness image. Source archive contains tracked files only.
FROM node:22-bookworm-slim
ENV CI=1 PNPM_HOME=/opt/pnpm PATH=/opt/pnpm:/root/.local/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git python3 python3-venv postgresql-client lsof \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g pnpm@10.11.0 \
    && python3 -m venv /opt/uv \
    && /opt/uv/bin/pip install --no-cache-dir uv==0.9.9
COPY source.tar /tmp/source.tar
WORKDIR /work
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/browsers
RUN tar -xf /tmp/source.tar -C /work && rm /tmp/source.tar \
    && pnpm install --frozen-lockfile \
    && pnpm --dir auth-worker install --frozen-lockfile \
    && pnpm --dir sync-worker install --frozen-lockfile \
    && /opt/uv/bin/uv sync --project smart-tests --frozen \
    && pnpm exec playwright install --with-deps chromium \
    && chmod -R a+rX /root/.local /root/.cache /work/smart-tests/.venv \
    && chmod o+x /root /root/.local /root/.local/share \
    && chown -R node:node /work /opt/browsers
USER node
ENV HOME=/home/node
