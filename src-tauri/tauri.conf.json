{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aquilla",
  "version": "0.2.2",
  "identifier": "com.frontierrnd.aquilla",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev:vite -- --port 1420 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": ["default"],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "media-src": "'self' data: blob: https:",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss: http://localhost:49152",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'",
        "frame-src": "https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Frontier RnD Ltd.",
    "copyright": "© 2026 Frontier RnD Ltd.",
    "homepage": "https://aquilla.app",
    "category": "Productivity",
    "shortDescription": "Translators, lifted.",
    "longDescription": "Aquilla is a collaborative workspace for translation teams, built by Frontier RnD Ltd. Open source under the MIT license.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Ryder Wishart (GW63HDZ4G9)",
      "providerShortName": "GW63HDZ4G9",
      "minimumSystemVersion": "11.0",
      "entitlements": "./Entitlements.plist",
      "infoPlist": "./Info.plist"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.sectigo.com",
      "tsp": false
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["aquilla", "codex"]
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/genesis-ai-dev/aquilla/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0RTdEOENGMTlGREVGRkQKUldUOTcvMFp6OWpueE1TYlBwZmNJMEpLN0VFSEI0UmxQWEx4NDBpNjRkdGlBaGIyWUc0dFFRQWIK"
    }
  }
}
