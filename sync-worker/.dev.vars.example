# Copy to .dev.vars for local dev (.dev.vars is gitignored).
# For production secrets use: wrangler secret put SECRET_KEY

# Must match frontier-server's SECRET_KEY so /sync-token JWTs verify here.
SECRET_KEY="test-secret-key-for-ci"

# Dev bypass. Lets clients connect without a valid sync-token JWT. Safe for
# local dev while the client isn't yet fetching /sync-token. DO NOT set this
# in production — prod default (unset) enforces strict auth.
ALLOW_UNAUTHENTICATED="true"
