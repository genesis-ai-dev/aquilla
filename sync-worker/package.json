{
  "name": "aquilla-sync-worker",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:workers-build": "node ../scripts/assert-workers-build-env.mjs && pnpm run type-check && pnpm test",
    "deploy:workers-build": "node ../scripts/cloudflare-build-deploy.mjs sync",
    "deploy": "pnpm --dir .. run deploy:aquilla:sync",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.1",
    "partyserver": "^0.5.10",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@electric-sql/pglite": "^0.5.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.4",
    "wrangler": "^4.120.0"
  }
}
