{
  "name": "aquilla-sync-worker",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:workers-build": "node ../scripts/assert-workers-build-env.mjs && pnpm run type-check",
    "deploy:workers-build": "node ../scripts/cloudflare-build-deploy.mjs sync",
    "deploy": "pnpm --dir .. run deploy:aquilla:sync",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.runtime.json",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "partyserver": "^0.5.10",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@electric-sql/pglite": "^0.5.14",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.1"
  }
}
