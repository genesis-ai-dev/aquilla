{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Code shared from ../src is written against the `@/` alias and, in modules
    // the contract tests import, Vite's types. tsconfig.runtime.json checks the
    // Worker code without Vite's types.
    "types": ["@cloudflare/workers-types", "node", "vite/client"],
    "paths": { "@/*": ["../src/*"] },
    "lib": ["ES2022"]
  },
  "include": ["src/**/*.ts"]
}
