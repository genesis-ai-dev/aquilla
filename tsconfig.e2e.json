{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* E2E helpers intentionally reuse selected src/ parsers so their seeded
     * state cannot drift from real imports. Those parsers use the app alias. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["e2e/**/*.ts"],
  // e2e/tauri/** is a separate WebdriverIO/Mocha project (browser/expect/describe/it come from
  // @wdio/globals + @wdio/mocha-framework, not this Playwright/Node project's ambient types) —
  // see e2e/tauri/tsconfig.json. It's release-gated (tauri-release.yml), not part of `tsc -b`.
  "exclude": ["e2e/tauri/**"]
}
