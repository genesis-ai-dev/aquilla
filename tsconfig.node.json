{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node", "vitest/config"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Path aliases — scripts/ pull in src/ modules that use the @/ alias */
    "paths": {
      "@aquilla/idml-roundtrip": ["./packages/idml-roundtrip/src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["vite.config.ts", "scripts/**/*.ts"],
  /* Worker-package imports need auth-worker/sync-worker installs. Cloudflare
   * SPA builds only `pnpm install` at the repo root, so typechecking these
   * one-off tools here fails with TS2307 (e.g. bcryptjs / @noble/hashes). */
  "exclude": [
    "scripts/migrate-users.ts",
    "scripts/mock-legacy-migration.ts",
    "scripts/neon-backfill-progress.ts",
    "scripts/pg-build-projections.ts"
  ]
}
